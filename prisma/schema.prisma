// Nexus-Tel Employee Portal — Prisma schema (PostgreSQL 16)
// Design reference: docs/DESIGN.md §2
//
// Conventions
// - uuid primary keys generated by the database
// - "date" columns (attendance_date, effective_from, ...) are calendar dates in the company timezone,
//   stored as DATE and handled through src/lib/dates.ts (never via local Date getters)
// - money is Decimal(14,2); times of day are minutes since midnight (Int)
// - a few constraints Prisma cannot express (exclusion constraints, partial unique indexes)
//   live in prisma/migrations/*/migration.sql

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  PROBATION
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  HALF_DAY
  HOLIDAY
  WEEKLY_OFF
}

enum AttendanceSource {
  SELF
  ADMIN
  SYSTEM
  LEAVE_APPROVAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AdjustmentType {
  BONUS
  DEDUCTION
}

enum PayrollRunStatus {
  DRAFT
  FINALIZED
  REOPENED
}

enum SalaryBasis {
  WORKING_DAYS
  CALENDAR_DAYS
  FIXED_DIVISOR
}

enum LatePenaltyMode {
  NONE
  LATES_TO_ABSENT
  FIXED_AMOUNT
  FRACTION_OF_DAY
}

enum RoundingMode {
  HALF_UP
  FLOOR
  CEIL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  ATTENDANCE_MARK
  ATTENDANCE_CORRECT
  LEAVE_REVIEW
  PAYROLL_RUN
  PAYROLL_FINALIZE
  PAYROLL_REOPEN
  EXPORT
}

// ───────────────────────── Identity & access ─────────────────────────

model User {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String    @unique // stored lower-cased
  passwordHash        String    @map("password_hash")
  role                UserRole  @default(EMPLOYEE)
  isActive            Boolean   @default(true) @map("is_active")
  mustChangePassword  Boolean   @default(true) @map("must_change_password")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee            Employee?
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ───────────────────────── Organisation & employees ─────────────────────────

model Department {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String     @unique
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  employees Employee[]

  @@map("departments")
}

model Employee {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String         @unique @map("user_id") @db.Uuid
  employeeCode          String         @unique @map("employee_code")
  firstName             String         @map("first_name")
  lastName              String         @map("last_name")
  phone                 String?
  personalEmail         String?        @map("personal_email")
  nationalIdEncrypted   String?        @map("national_id_encrypted") // AES-256-GCM, see src/lib/crypto.ts
  nationalIdLast4       String?        @map("national_id_last4")
  dateOfBirth           DateTime?      @map("date_of_birth") @db.Date
  gender                String?
  address               String?
  emergencyContactName  String?        @map("emergency_contact_name")
  emergencyContactPhone String?        @map("emergency_contact_phone")
  departmentId          String?        @map("department_id") @db.Uuid
  designation           String?
  employmentType        EmploymentType @default(FULL_TIME) @map("employment_type")
  managerId             String?        @map("manager_id") @db.Uuid
  joinedAt              DateTime       @map("joined_at") @db.Date
  probationEndsAt       DateTime?      @map("probation_ends_at") @db.Date
  terminatedAt          DateTime?      @map("terminated_at") @db.Date
  isActive              Boolean        @default(true) @map("is_active")
  bankName              String?        @map("bank_name")
  bankAccountEncrypted  String?        @map("bank_account_encrypted")
  bankAccountLast4      String?        @map("bank_account_last4")
  bankAccountTitle      String?        @map("bank_account_title")
  notes                 String?
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User                @relation(fields: [userId], references: [id])
  department    Department?         @relation(fields: [departmentId], references: [id])
  manager       Employee?           @relation("EmployeeManager", fields: [managerId], references: [id])
  reports       Employee[]          @relation("EmployeeManager")
  salaries      EmployeeSalary[]
  schedules     EmployeeSchedule[]
  attendance    AttendanceRecord[]
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  adjustments   PayrollAdjustment[]
  payslips      Payslip[]

  @@index([departmentId])
  @@index([isActive])
  @@map("employees")
}

model EmployeeSalary {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  baseSalary    Decimal   @map("base_salary") @db.Decimal(14, 2)
  currency      String    @default("PKR") @db.Char(3)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  reason        String?
  createdById   String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  employee   Employee          @relation(fields: [employeeId], references: [id])
  components SalaryComponent[]

  @@index([employeeId, effectiveFrom])
  @@map("employee_salaries")
}

model SalaryComponent {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salaryId   String         @map("salary_id") @db.Uuid
  name       String
  kind       AdjustmentType // BONUS = earning, DEDUCTION = deduction
  amount     Decimal        @db.Decimal(14, 2)
  isProrated Boolean        @default(false) @map("is_prorated")

  salary EmployeeSalary @relation(fields: [salaryId], references: [id], onDelete: Cascade)

  @@map("salary_components")
}

// ───────────────────────── Schedules, windows, holidays ─────────────────────────

model WorkSchedule {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String   @unique
  timezone               String   @default("Asia/Karachi")
  shiftStartMin          Int      @map("shift_start_min") // minutes after local midnight
  shiftEndMin            Int      @map("shift_end_min") // may be < shiftStartMin => crosses midnight
  workingDays            Int[]    @default([1, 2, 3, 4, 5]) @map("working_days") // ISO 1=Mon..7=Sun
  checkinOpensMinBefore  Int      @default(60) @map("checkin_opens_min_before")
  lateAfterMin           Int      @default(15) @map("late_after_min")
  halfDayAfterMin        Int      @default(240) @map("half_day_after_min")
  checkinClosesAfterMin  Int      @default(480) @map("checkin_closes_after_min")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments EmployeeSchedule[]
  overrides   AttendanceWindowOverride[]
  settings    CompanySettings[]

  @@map("work_schedules")
}

model EmployeeSchedule {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  scheduleId    String    @map("schedule_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdById   String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee     @relation(fields: [employeeId], references: [id])
  schedule WorkSchedule @relation(fields: [scheduleId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@map("employee_schedules")
}

model Holiday {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date      DateTime @unique @db.Date
  name      String
  isPaid    Boolean  @default(true) @map("is_paid")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("holidays")
}

model AttendanceWindowOverride {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date                  DateTime @db.Date
  scheduleId            String?  @map("schedule_id") @db.Uuid // null = all schedules
  checkinOpensMinBefore Int?     @map("checkin_opens_min_before")
  lateAfterMin          Int?     @map("late_after_min")
  halfDayAfterMin       Int?     @map("half_day_after_min")
  checkinClosesAfterMin Int?     @map("checkin_closes_after_min")
  reason                String?
  createdById           String   @map("created_by") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  schedule WorkSchedule? @relation(fields: [scheduleId], references: [id])

  @@unique([date, scheduleId])
  @@map("attendance_window_overrides")
}

// ───────────────────────────── Attendance ─────────────────────────────

model AttendanceRecord {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId     String           @map("employee_id") @db.Uuid
  attendanceDate DateTime         @map("attendance_date") @db.Date
  status         AttendanceStatus
  checkInAt      DateTime?        @map("check_in_at") @db.Timestamptz(6)
  minutesLate    Int?             @map("minutes_late")
  source         AttendanceSource
  markedById     String?          @map("marked_by_user_id") @db.Uuid
  leaveRequestId String?          @map("leave_request_id") @db.Uuid
  note           String?
  ipAddress      String?          @map("ip_address")
  isLocked       Boolean          @default(false) @map("is_locked")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee     Employee               @relation(fields: [employeeId], references: [id])
  leaveRequest LeaveRequest?          @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  corrections  AttendanceCorrection[]

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
  @@map("attendance_records")
}

model AttendanceCorrection {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendanceRecordId String            @map("attendance_record_id") @db.Uuid
  previousStatus     AttendanceStatus? @map("previous_status")
  previousCheckInAt  DateTime?         @map("previous_check_in_at") @db.Timestamptz(6)
  newStatus          AttendanceStatus  @map("new_status")
  newCheckInAt       DateTime?         @map("new_check_in_at") @db.Timestamptz(6)
  reason             String
  correctedById      String            @map("corrected_by") @db.Uuid
  correctedAt        DateTime          @default(now()) @map("corrected_at") @db.Timestamptz(6)

  record AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@map("attendance_corrections")
}

// ───────────────────────────── Leave ─────────────────────────────

model LeaveType {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @unique
  code            String   @unique
  isPaid          Boolean  @default(true) @map("is_paid")
  annualQuotaDays Decimal? @map("annual_quota_days") @db.Decimal(5, 1) // null = unlimited
  minNoticeDays   Int      @default(0) @map("min_notice_days")
  allowHalfDay    Boolean  @default(false) @map("allow_half_day")
  isActive        Boolean  @default(true) @map("is_active")

  requests LeaveRequest[]
  balances LeaveBalance[]

  @@map("leave_types")
}

model LeaveBalance {
  employeeId     String  @map("employee_id") @db.Uuid
  leaveTypeId    String  @map("leave_type_id") @db.Uuid
  year           Int
  allocatedDays  Decimal @map("allocated_days") @db.Decimal(5, 1)
  adjustmentDays Decimal @default(0) @map("adjustment_days") @db.Decimal(5, 1)

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@id([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String      @map("employee_id") @db.Uuid
  leaveTypeId  String      @map("leave_type_id") @db.Uuid
  startDate    DateTime    @map("start_date") @db.Date
  endDate      DateTime    @map("end_date") @db.Date
  isHalfDay    Boolean     @default(false) @map("is_half_day")
  workingDays  Decimal     @map("working_days") @db.Decimal(5, 1)
  reason       String
  status       LeaveStatus @default(PENDING)
  reviewedById String?     @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?   @map("reviewed_at") @db.Timestamptz(6)
  reviewNote   String?     @map("review_note")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee   Employee           @relation(fields: [employeeId], references: [id])
  leaveType  LeaveType          @relation(fields: [leaveTypeId], references: [id])
  attendance AttendanceRecord[]

  @@index([employeeId, status])
  @@index([status])
  @@map("leave_requests")
}

// ───────────────────────────── Payroll ─────────────────────────────

model PayrollPolicy {
  id                       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String
  effectiveFrom            DateTime        @unique @map("effective_from") @db.Date
  salaryBasis              SalaryBasis     @default(WORKING_DAYS) @map("salary_basis")
  fixedDivisor             Int?            @map("fixed_divisor")
  countHolidaysAsPaid      Boolean         @default(true) @map("count_holidays_as_paid")
  countWeeklyOffAsPaid     Boolean         @default(true) @map("count_weekly_off_as_paid")
  absentDeductionDays      Decimal         @default(1.00) @map("absent_deduction_days") @db.Decimal(4, 2)
  halfDayDeductionDays     Decimal         @default(0.50) @map("half_day_deduction_days") @db.Decimal(4, 2)
  unpaidLeaveDeductionDays Decimal         @default(1.00) @map("unpaid_leave_deduction_days") @db.Decimal(4, 2)
  latePenaltyMode          LatePenaltyMode @default(LATES_TO_ABSENT) @map("late_penalty_mode")
  latesPerAbsent           Int?            @default(3) @map("lates_per_absent")
  latePenaltyAmount        Decimal?        @map("late_penalty_amount") @db.Decimal(14, 2)
  latePenaltyDayFraction   Decimal?        @map("late_penalty_day_fraction") @db.Decimal(4, 2)
  lateGraceCount           Int             @default(0) @map("late_grace_count")
  prorateNewJoiners        Boolean         @default(true) @map("prorate_new_joiners")
  roundingMode             RoundingMode    @default(HALF_UP) @map("rounding_mode")
  roundingPrecision        Int             @default(0) @map("rounding_precision")
  currency                 String          @default("PKR") @db.Char(3)
  createdById              String          @map("created_by") @db.Uuid
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  runs PayrollRun[]

  @@map("payroll_policies")
}

model PayrollAdjustment {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String         @map("employee_id") @db.Uuid
  periodYear  Int            @map("period_year")
  periodMonth Int            @map("period_month")
  kind        AdjustmentType
  category    String
  amount      Decimal        @db.Decimal(14, 2)
  description String?
  createdById String         @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  payslipId   String?        @map("payslip_id") @db.Uuid // set once consumed by a FINALIZED run

  employee Employee @relation(fields: [employeeId], references: [id])
  payslip  Payslip? @relation(fields: [payslipId], references: [id], onDelete: SetNull)

  @@index([periodYear, periodMonth, employeeId])
  @@map("payroll_adjustments")
}

model PayrollRun {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodYear     Int              @map("period_year")
  periodMonth    Int              @map("period_month")
  status         PayrollRunStatus @default(DRAFT)
  policyId       String           @map("policy_id") @db.Uuid
  policySnapshot Json             @map("policy_snapshot")
  employeeCount  Int              @default(0) @map("employee_count")
  totalGross     Decimal          @default(0) @map("total_gross") @db.Decimal(14, 2)
  totalNet       Decimal          @default(0) @map("total_net") @db.Decimal(14, 2)
  runById        String           @map("run_by") @db.Uuid
  runAt          DateTime         @default(now()) @map("run_at") @db.Timestamptz(6)
  finalizedById  String?          @map("finalized_by") @db.Uuid
  finalizedAt    DateTime?        @map("finalized_at") @db.Timestamptz(6)
  reopenedById   String?          @map("reopened_by") @db.Uuid
  reopenedAt     DateTime?        @map("reopened_at") @db.Timestamptz(6)
  reopenReason   String?          @map("reopen_reason")
  notes          String?

  policy   PayrollPolicy @relation(fields: [policyId], references: [id])
  payslips Payslip[]

  @@unique([periodYear, periodMonth])
  @@map("payroll_runs")
}

model Payslip {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollRunId        String    @map("payroll_run_id") @db.Uuid
  employeeId          String    @map("employee_id") @db.Uuid
  payslipNumber       String?   @unique @map("payslip_number") // assigned at finalize
  employeeSnapshot    Json      @map("employee_snapshot")
  salarySnapshot      Json      @map("salary_snapshot")
  calendarDays        Int       @map("calendar_days")
  workingDays         Int       @map("working_days")
  payableDays         Decimal   @map("payable_days") @db.Decimal(6, 2)
  presentDays         Int       @map("present_days")
  lateDays            Int       @map("late_days")
  halfDays            Int       @map("half_days")
  absentDays          Int       @map("absent_days")
  paidLeaveDays       Decimal   @map("paid_leave_days") @db.Decimal(5, 1)
  unpaidLeaveDays     Decimal   @map("unpaid_leave_days") @db.Decimal(5, 1)
  holidayDays         Int       @map("holiday_days")
  weeklyOffDays       Int       @map("weekly_off_days")
  perDayRate          Decimal   @map("per_day_rate") @db.Decimal(14, 4)
  baseEarned          Decimal   @map("base_earned") @db.Decimal(14, 2)
  componentsEarned    Decimal   @default(0) @map("components_earned") @db.Decimal(14, 2)
  componentsDeducted  Decimal   @default(0) @map("components_deducted") @db.Decimal(14, 2)
  attendanceDeduction Decimal   @default(0) @map("attendance_deduction") @db.Decimal(14, 2)
  lateDeduction       Decimal   @default(0) @map("late_deduction") @db.Decimal(14, 2)
  bonusesTotal        Decimal   @default(0) @map("bonuses_total") @db.Decimal(14, 2)
  deductionsTotal     Decimal   @default(0) @map("deductions_total") @db.Decimal(14, 2)
  grossPay            Decimal   @map("gross_pay") @db.Decimal(14, 2)
  netPay              Decimal   @map("net_pay") @db.Decimal(14, 2)
  currency            String    @db.Char(3)
  breakdown           Json
  generatedAt         DateTime  @default(now()) @map("generated_at") @db.Timestamptz(6)
  supersededAt        DateTime? @map("superseded_at") @db.Timestamptz(6)

  run         PayrollRun          @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee    Employee            @relation(fields: [employeeId], references: [id])
  adjustments PayrollAdjustment[]

  @@index([employeeId])
  @@index([payrollRunId, employeeId])
  @@map("payslips")
}

// ───────────────────────────── Settings & audit ─────────────────────────────

model CompanySettings {
  id                    Int      @id @default(1)
  companyName           String   @default("Nexus-Tel") @map("company_name")
  timezone              String   @default("Asia/Karachi")
  currency              String   @default("PKR") @db.Char(3)
  defaultScheduleId     String?  @map("default_schedule_id") @db.Uuid
  attendanceIpAllowlist String[] @default([]) @map("attendance_ip_allowlist") // CIDR strings; empty = no restriction
  payslipFooter         String?  @map("payslip_footer")
  updatedById           String?  @map("updated_by") @db.Uuid
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  defaultSchedule WorkSchedule? @relation(fields: [defaultScheduleId], references: [id])

  @@map("company_settings")
}

model AuditLog {
  id          BigInt      @id @default(autoincrement())
  actorUserId String?     @map("actor_user_id") @db.Uuid
  actorRole   UserRole?   @map("actor_role")
  action      AuditAction
  entityType  String      @map("entity_type")
  entityId    String?     @map("entity_id")
  beforeData  Json?       @map("before_data")
  afterData   Json?       @map("after_data")
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
